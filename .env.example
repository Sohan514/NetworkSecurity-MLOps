# Copy to .env and fill in locally. Never commit .env.
MONGO_DB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.example.mongodb.net/?retryWrites=true&w=majority

# Leave local MLflow as the default; configure DagsHub only with your own account.
MLFLOW_TRACKING_URI=file:./mlruns
# MLFLOW_TRACKING_USERNAME=YOUR_USERNAME
# MLFLOW_TRACKING_PASSWORD=YOUR_NEW_TOKEN
# MLFLOW_REGISTRY_URI=https://dagshub.com/YOUR_USERNAME/YOUR_REPO.mlflow
# MLFLOW_REGISTERED_MODEL_NAME=NetworkSecurityClassifier

# Optional: enables S3 artifact sync for the FastAPI training pipeline.
# TRAINING_BUCKET_NAME=YOUR_S3_BUCKET
# AWS_REGION=us-east-1

# Optional: needed to enable POST /train. Keep private.
# TRAINING_API_KEY=USE_A_RANDOM_SECRET_HERE
